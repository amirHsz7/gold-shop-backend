generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum GoldPriceStatus {
  AVAILABLE
  UNAVAILABLE
}

model User {
  id               String    @id @default(cuid())
  mobile           String    @unique
  fullName         String
  role             UserRole  @default(CUSTOMER)
  // ادمین‌ها: دریافت پیامک سفارش جدید
  receivesOrderSms Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  comments         Comment[]

  addresses       Address[]
  cart            Cart?
  orders          Order[]
  cancelledOrders Order[]    @relation("OrderCancelledBy")
  auditLogs       AuditLog[] @relation("AuditActor")
  auditTargets    AuditLog[] @relation("AuditTarget")
}

model Otp {
  id        String     @id @default(cuid())
  mobile    String     @unique
  codeHash  String
  purpose   OtpPurpose
  fullName  String?
  expiresAt DateTime
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([expiresAt])
}

// ----------------------------------------

// ───────── دسته‌بندی و کالکشن ─────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageKey  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageKey    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

// ───────── محصول ─────────

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  minWeight       Decimal @default(0) @db.Decimal(10, 3)
  maxWeight       Decimal @default(0) @db.Decimal(10, 3)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  isActive   Boolean   @default(true)
  isFeatured Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  comments Comment[]

  metaTitle       String? @db.VarChar(70)
  metaDescription String? @db.VarChar(200)

  // کش قیمت؛ فقط سرویس قیمت این‌ها را می‌نویسد
  minPrice Decimal? @db.Decimal(15, 0)
  maxPrice Decimal? @db.Decimal(15, 0)

  @@index([categoryId, isActive])
  @@index([collectionId, isActive])
  @@index([isFeatured, isActive])
  @@index([isActive, minPrice])
}

// هر ردیف = یک وزن مشخص با تعداد موجودی همان وزن
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label         String?
  sku           String?  @unique
  weight        Decimal  @db.Decimal(10, 3) // گرم
  fee           Decimal  @default(0) @db.Decimal(6, 3) // درصد اجرت از وزن
  feeAmount     Decimal  @default(0) @db.Decimal(15, 0) // اجرت ریالی
  price         Decimal? @db.Decimal(15, 0) // قیمت نهایی بعد از تخفیف (تومان)
  originalPrice Decimal? @db.Decimal(15, 0) // قیمت قبل از تخفیف
  stock         Int      @default(1)
  reservedStock Int      @default(0)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@unique([productId, weight])
  @@index([productId, isActive, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ───────── کامنت و امتیاز ─────────

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  body       String        @db.Text
  rating     Int?
  status     CommentStatus @default(PENDING)
  showOnHome Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([productId, parentId, status, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([showOnHome, status])
}

// ───────── صفحه‌ی اصلی ─────────

enum HomeSectionType {
  SLIDER
  BANNERS
  PRODUCTS
  CATEGORIES
  COLLECTIONS
  TESTIMONIALS
  MAP
}

model HomeSection {
  id           String            @id @default(cuid())
  type         HomeSectionType
  title        String?
  subtitle     String?
  config       Json?
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  singletonKey String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        HomeSectionItem[]

  @@index([isActive, sortOrder])
}

model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  imageKey       String
  mobileImageKey String?
  alt            String?
  title          String?
  subtitle       String?
  buttonText     String?
  linkUrl        String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sectionId, isActive, sortOrder])
}

model ShopInfo {
  id           String   @id @default("main")
  address      String?  @db.Text
  latitude     Float?
  longitude    Float?
  phones       String[] @default([])
  email        String?
  workingHours String?  @db.Text
  instagram    String?
  telegram     String?
  whatsapp     String?
  updatedAt    DateTime @updatedAt
}

// ───────── تماس با ما و درباره‌ی ما ─────────

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  mobile    String
  email     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt])
}

model AboutPage {
  id          String   @id @default("main")
  title       String
  content     String   @db.Text
  imageKey    String?
  foundedYear Int?
  updatedAt   DateTime @updatedAt
}

// ───────── تنظیمات قیمت‌گذاری ─────────
enum DiscountBase {
  TOTAL
  FEE
}

model PricingSetting {
  id                  String  @id @default("main")
  sellerProfitPercent Decimal @default(7) @db.Decimal(5, 2)
  vatPercent          Decimal @default(10) @db.Decimal(5, 2)

  // قیمت هر گرم طلای ۱۸ عیار به تومان؛ فعلاً دستی، بعداً از TGN
  goldPricePerGram   Int?
  goldPriceSource    String    @default("manual")
  goldPriceUpdatedAt DateTime?

  goldPriceStatus GoldPriceStatus @default(UNAVAILABLE)

  discountBase    DiscountBase @default(TOTAL)
  feeAmountInRial Boolean      @default(false)
  roundTo         Int          @default(1000)

  // نسخه‌ی قیمت منتشرشده؛ با هر تغییر قیمت طلا یکی زیاد می‌شود
  priceVersion Int @default(1)

  // ارسال
  shippingCost          Int      @default(0) // تومان
  freeShippingMinWeight Decimal? @db.Decimal(10, 3) // گرم؛ خالی = ارسال رایگان خاموش

  updatedAt DateTime @updatedAt
}

// ───────── تاریخچه‌ی قیمت طلا ─────────

model GoldPriceHistory {
  id           String   @id @default(cuid())
  pricePerGram Int
  source       String
  version      Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ───────── آدرس‌ها ─────────

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(50) // خانه، محل کار، ...
  province   String
  city       String
  address    String   @db.Text
  postalCode String   @db.VarChar(10)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ───────── سبد خرید ─────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

// ───────── سفارش و پرداخت ─────────

enum OrderStatus {
  PENDING_PAYMENT // ساخته شده، منتظر پرداخت (موجودی نگه داشته شده)
  PREPARING // پرداخت موفق، در حال آماده‌سازی
  SHIPPED // ارسال شده، کد رهگیری ثبت شده
  CANCELLED // لغو توسط ادمین
  EXPIRED // پرداخت انجام نشد و مهلت تمام شد
  NEEDS_REVIEW // پرداخت دیرهنگام و موجودی نبود؛ بررسی دستی و بازگشت وجه
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement()) // شماره‌ی نمایشی
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING_PAYMENT)

  // گیرنده و آدرس (کپی لحظه‌ی خرید)
  recipientName   String
  recipientMobile String
  province        String
  city            String
  address         String @db.Text
  postalCode      String @db.VarChar(10)

  // مبالغ (تومان)
  itemsTotal    Decimal @db.Decimal(15, 0)
  discountTotal Decimal @default(0) @db.Decimal(15, 0)
  shippingCost  Decimal @default(0) @db.Decimal(15, 0)
  totalAmount   Decimal @db.Decimal(15, 0)
  freeShipping  Boolean @default(false)
  totalWeight   Decimal @db.Decimal(10, 3)

  // قیمت طلا و نسخه‌ی قیمت لحظه‌ی خرید
  goldPricePerGram Int
  priceVersion     Int

  // موجودی
  reservationExpiresAt DateTime?
  stockReleasedAt      DateTime?
  stockCommittedAt     DateTime?

  // ارسال
  trackingCode String?
  shippedAt    DateTime?

  // لغو
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?   @db.Text
  refundPending Boolean   @default(false)
  refundedAt    DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  idempotencyKey String? @db.VarChar(100)
  requestHash    String? @db.VarChar(64)

  items        OrderItem[]
  payments     Payment[]
  smsLogs      SmsLog[]
  reservations StockReservation[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
}

// کپی (snapshot) از محصول در لحظه‌ی خرید؛ با تغییر یا حذف محصول عوض نمی‌شود
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName       String
  productSlug       String?
  imageKey          String?
  karat             Int     @default(18)
  weight            Decimal @db.Decimal(10, 3)
  quantity          Int
  unitPrice         Decimal @db.Decimal(15, 0) // بعد از تخفیف
  originalUnitPrice Decimal @db.Decimal(15, 0)
  discountPercent   Decimal @default(0) @db.Decimal(5, 2)

  // ریز محاسبه (طلا، اجرت، سود، مالیات) برای فاکتور در صورت نیاز حسابدار
  breakdown Json?

  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway       String // simulator، بعداً نام درگاه واقعی
  amount        Decimal       @db.Decimal(15, 0)
  status        PaymentStatus @default(PENDING)
  authority     String? // شناسه‌ی تراکنش درگاه
  checkoutUrl   String?
  refId         String? // کد پیگیری بانک
  cardPan       String? // فقط ۴ رقم آخر یا ماسک‌شده
  failureReason String?
  expiresAt     DateTime // پایان نگه‌داشتن موجودی
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([gateway, authority])
  @@index([orderId])
  @@index([status, expiresAt])
}

model StockReservation {
  id String @id @default(cuid())

  orderId   String
  variantId String

  quantity Int
  status   ReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@index([orderId, status])
}

// ───────── پیامک ─────────

enum SmsType {
  ORDER_NEW_ADMIN
  ORDER_PAID_CUSTOMER
  ORDER_SHIPPED_CUSTOMER
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

model SmsLog {
  id        String    @id @default(cuid())
  type      SmsType
  recipient String
  text      String    @db.Text
  status    SmsStatus @default(PENDING)
  attempts  Int       @default(0)
  error     String?
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // جلوگیری از ارسال تکراری برای یک سفارش
  @@unique([type, orderId, recipient])
  @@index([status, createdAt])
}

// ───────── لاگ تغییرات حساس ─────────

model AuditLog {
  id           String   @id @default(cuid())
  action       String // مثلاً ROLE_CHANGED
  actorId      String
  actor        User     @relation("AuditActor", fields: [actorId], references: [id])
  targetUserId String?
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id])
  details      Json? // مثلاً { from: "CUSTOMER", to: "ADMIN" }
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}
