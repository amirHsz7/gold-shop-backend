generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

model User {
  id        String    @id @default(cuid())
  mobile    String    @unique
  fullName  String
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Otp {
  id        String     @id @default(cuid())
  mobile    String     @unique
  codeHash  String
  purpose   OtpPurpose
  fullName  String?
  expiresAt DateTime
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([expiresAt])
}

// ----------------------------------------

// ───────── دسته‌بندی و کالکشن ─────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageKey  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageKey    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

// ───────── محصول ─────────

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  minWeight       Decimal @default(0) @db.Decimal(10, 3)
  maxWeight       Decimal @default(0) @db.Decimal(10, 3)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  isActive   Boolean   @default(true)
  isFeatured Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  comments Comment[]

  @@index([categoryId, isActive])
  @@index([collectionId, isActive])
  @@index([isFeatured, isActive])
}

// هر ردیف = یک وزن مشخص با تعداد موجودی همان وزن
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label     String?
  sku       String?  @unique
  weight    Decimal  @db.Decimal(10, 3) // گرم
  fee       Decimal  @default(0) @db.Decimal(6, 3) // درصد اجرت از وزن
  feeAmount Decimal  @default(0) @db.Decimal(15, 0) // اجرت ریالی
  stock     Int      @default(1)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, weight])
  @@index([productId, isActive, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ───────── کامنت و امتیاز ─────────

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  body      String        @db.Text
  rating    Int?
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([productId, parentId, status, createdAt])
  @@index([parentId])
  @@index([userId])
}

// ───────── صفحه‌ی اصلی ─────────

enum HomeSectionType {
  SLIDER
  BANNERS
  PRODUCTS
  CATEGORIES
  COLLECTIONS
}

model HomeSection {
  id        String          @id @default(cuid())
  type      HomeSectionType
  title     String?
  subtitle  String?
  config    Json?
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items HomeSectionItem[]

  @@index([isActive, sortOrder])
}

model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  imageKey       String
  mobileImageKey String?
  alt            String?
  title          String?
  subtitle       String?
  buttonText     String?
  linkUrl        String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sectionId, isActive, sortOrder])
}

// ───────── تماس با ما و درباره‌ی ما ─────────

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  mobile    String
  email     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt])
}

model AboutPage {
  id           String   @id @default("main")
  title        String
  content      String   @db.Text
  imageUrl     String?
  foundedYear  Int?
  address      String?
  phone        String?
  email        String?
  workingHours String?
  mapUrl       String?
  updatedAt    DateTime @updatedAt
}
